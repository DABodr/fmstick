#!/usr/bin/make -f
# Debian packaging of FmStick: Qt6 build, out of tree (the root Makefile
# is an old Qt4 one).
# Modified 2026-11-26 by Aurel: Qt6 build for Debian 12.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

B = build-deb

%:
	dh $@

override_dh_auto_clean:
	rm -rf $(B)

override_dh_auto_configure:
	mkdir -p $(B)
	cd $(B) && /usr/lib/qt6/bin/qmake ../fmstick.pro PREFIX=/usr \
		QMAKE_CFLAGS+="$(CFLAGS) $(CPPFLAGS)" \
		QMAKE_CXXFLAGS+="$(CXXFLAGS) $(CPPFLAGS)" \
		QMAKE_LFLAGS+="$(LDFLAGS)" \
		QMAKE_LRELEASE=/usr/lib/qt6/bin/lrelease

override_dh_auto_build:
	$(MAKE) -C $(B)

override_dh_auto_install:
	$(MAKE) -C $(B) install INSTALL_ROOT=$(CURDIR)/debian/fmstick

override_dh_installudev:
	dh_installudev --priority=60

# no test suite
override_dh_auto_test:
